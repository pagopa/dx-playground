<policies>
    <inbound>
        <base />
        <authentication-managed-identity resource="${entra-id-app}" />
        <choose>
            <when condition="@(context.Operation.UrlTemplate.StartsWith(&quot;/ca/&quot;))">
                <set-backend-service backend-id="${container-backend-id}" />
                <rewrite-uri template="@(context.Request.Url.Path.Substring(context.Request.Url.Path.IndexOf(&quot;/ca/&quot;) + 3))" />
            </when>
            <otherwise>
                <set-backend-service backend-id="${backend-id}" />
            </otherwise>
        </choose>
        <cors>
            <allowed-origins>
                <origin>*</origin>
            </allowed-origins>
            <allowed-methods>
                <method>*</method>
            </allowed-methods>
            <allowed-headers>
                <header>*</header>
            </allowed-headers>
            <expose-headers>
                <header>*</header>
            </expose-headers>
        </cors>
    </inbound>
    <outbound>
        <base />
    </outbound>
    <backend>
        <base />
    </backend>
    <on-error>
        <base />
    </on-error>
</policies>
